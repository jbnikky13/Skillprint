{
  "name": "skillprint",
  "version": "0.1.0",
  "private": true,
  "description": "Career fingerprinting engine for matching candidates to global opportunities.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit",
    "benchmark": "npm run build && node --test test/benchmark.test.js test/embeddings.test.js",
    "check": "npm run typecheck && npm test",
    "smoke": "npm run build && node dist/smoke.js",
    "search": "npm run build && node dist/run-personal-search.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "mammoth": "^1.9.1",
    "pdf-parse": "^1.1.1",
    "@supabase/supabase-js": "^2.58.0"
  }
}
